# 複製本檔案為 .env，再填入實際值。
# .env 只保存部署密鑰與環境資訊；一般功能設定會由 Bot 在 settings/ 自動建立。

# ── 必要設定 ──────────────────────

DISCORD_TOKEN=


# ── 可選設定 ──────────────────────

# 留空時使用 Discord Application Owner / Team Owner。
OWNER_ID=

# 啟用 AI / Agent Module 時才需要。
GEMINI_API=

# 非必要：若有 Redis 服務才設定 URI；未設定時使用 SQLite + 本機 Guard。
# 如需含密碼的 URI，只放本機 .env，絕不可提交 GitHub。
AI_REDIS_URL=
